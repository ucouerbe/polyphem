{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "pm-sidebar",
            "props": {
              "role": "titlebar"
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "pm-sidebar",
          "type": "block",
          "content": {
            "mod": "pm-sidebar"
          },
          "size": {
            "weight": 1
          }
        },
        {
          "id": "pm-account",
          "type": "block",
          "content": {
            "mod": "pm-sidebar",
            "props": {
              "role": "footer"
            }
          },
          "size": {
            "px": 110
          }
        }
      ],
      "size": {
        "px": 280
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "pm-tabs"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main-col",
              "type": "column",
              "children": [
                {
                  "id": "pane-head",
                  "type": "block",
                  "content": {
                    "mod": "pm-summary",
                    "props": {
                      "role": "header"
                    }
                  },
                  "size": {
                    "px": 38
                  }
                },
                {
                  "id": "main-stack",
                  "type": "stack",
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "radius": 8,
                          "gap": 8
                        }
                      }
                    },
                    {
                      "id": "summary",
                      "type": "block",
                      "content": {
                        "mod": "pm-summary"
                      }
                    }
                  ],
                  "active": "main"
                }
              ],
              "background": "surface",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 10
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "pm-git"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "warm",
  "font": "Geist Mono",
  "font_size": 13,
  "ui_font": "Geist",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}